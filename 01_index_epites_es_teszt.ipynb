    "    persist_directory=\"chroma_db\",\n",
    ")\n",
    "\n",
    "print(\"-\" * 30)\n",
    "print(\"A vektortár sikeresen elkészült és elmentve a 'chroma_db' mappába.\")\n",
    "print(f\"Indexelt szegmensek száma: {vektortar._collection.count()}\")\n"
