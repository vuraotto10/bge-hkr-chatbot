    "def visszanyer(kerdes, k=5):\n",
    "    \"\"\"Visszaadja a kérdéshez leginkább releváns k darab szegmenst.\"\"\"\n",
    "    talalatok = vektortar.similarity_search(kerdes, k=k)\n",
    "    return talalatok\n",
    "\n",
    "# Gyors teszt\n",
    "teszt_kerdes = \"Hány kreditpontot kell teljesíteni a záróvizsgára bocsátáshoz?\"\n",
    "talalt_szegmensek = visszanyer(teszt_kerdes, k=5)\n",
    "\n",
    "for i, szegmens in enumerate(talalt_szegmensek, 1):\n",
    "    print(f\"--- {i}. találat ---\")\n",
    "    print(szegmens.page_content[:300])\n",
    "    print()\n"
   ]
