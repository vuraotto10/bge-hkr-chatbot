      "Ikt. sz.:  JSZI/27/2026 \n",
      "  \n",
      " \n",
      "BUDAPESTI GAZDASÁG TUDOMÁNY I EGYETEM  \n",
      "SZERVEZETI ÉS MŰKÖDÉSI SZABÁLYZATA  \n",
      "III. KÖTET  \n",
      "A \n",
      "BUDAPESTI GAZDASÁG TUDOMÁNY I EGYETEM  \n",
      "HALLGATÓI KÖVETELMÉNYRENDSZERE  \n",
      " \n",
      " \n",
      " \n",
      " \n",
      " \n",
      " \n",
      "2. kiadás  \n",
      "(2026. február  1. napjától hatályos változat)\n"
     ]
    }
   ],
   "source": [
    "text_splitter = RecursiveCharacterTextSplitter(\n",
    "    chunk_size=1000,       # egy szegmens kb. ennyi karakter hosszú\n",
    "    chunk_overlap=150,     # ennyi karakternyi átfedés a szegmensek között\n",
    "    separators=[\"\\n\\n\", \"\\n\", \". \", \" \", \"\"],\n",
    ")\n",
    "\n",
    "szegmensek = text_splitter.split_documents(dokumentumok)\n",
    "\n",
    "print(f\"Létrejött szegmensek száma: {len(szegmensek)}\")\n",
    "print(\"--- Egy minta szegmens ---\")\n",
    "print(szegmensek[0].page_content)\n"
   ]
