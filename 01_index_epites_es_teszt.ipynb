   "source": [
    "# Állítsd be a saját fájlneved szerint (PDF vagy DOCX)\n",
    "DOKUMENTUM_UTVONAL = r\"C:\\Users\\Ottó\\Downloads\\rag_szakdolgozat\\rag_szakdolgozat\\data\\bge_hkr.pdf.pdf\"   # <-- ide írd a saját fájlod nevét/útvonalát\n",
    "\n",
    "if DOKUMENTUM_UTVONAL.endswith(\".pdf\"):\n",
    "    loader = PyPDFLoader(DOKUMENTUM_UTVONAL)\n",
    "elif DOKUMENTUM_UTVONAL.endswith(\".docx\"):\n",
    "    loader = Docx2txtLoader(DOKUMENTUM_UTVONAL)\n",
    "else:\n",
    "    raise ValueError(\"Csak .pdf vagy .docx formátum támogatott.\")\n",
    "\n",
    "dokumentumok = loader.load()\n",
